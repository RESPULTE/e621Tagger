# Generate using: python -m backend.app.auth hash-password
# Keep the single quotes around the hash, including its dollar signs.
STUDIO_PASSWORD_HASH='scrypt$REPLACE_SALT$REPLACE_DIGEST'
# Enable only behind a proxy restricted to your private LAN/VPN. Sessions and CSRF remain required.
STUDIO_PASSWORDLESS=false
STUDIO_PUBLIC_ORIGIN=https://studio.your-private-domain.example
STUDIO_SECURE_COOKIE=true
STUDIO_BIND_ADDRESS=127.0.0.1
STUDIO_PORT=8000
STUDIO_E621_USERNAME=YOUR_E621_USERNAME
# Only needed for access that requires your e621 account.
STUDIO_E621_API_KEY=
STUDIO_MOCK_E621=false
# On-demand bounded published KNN rows; disable for fully offline review.
STUDIO_PUBLISHED_NEIGHBORS=true
STUDIO_CACHE_BYTES=5368709120
STUDIO_METADATA_INTERVAL=1
STUDIO_MEDIA_INTERVAL=0.25
STUDIO_MEDIA_CONCURRENCY=4
# Optional collection saves: merge deploy/docker-compose.library.yml.
# Must already exist; initialize once as described in docs/operations.md.
# STUDIO_LIBRARY_HOST_ROOT=/path/to/main/smut/folder
STUDIO_LIBRARY_MAX_BYTES=268435456
STUDIO_LIBRARY_RESERVE_BYTES=134217728
STUDIO_LIBRARY_TIMEOUT=300
