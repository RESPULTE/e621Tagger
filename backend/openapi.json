  "components": {
    "schemas": {
      "BatchItem": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "unsure"
            ],
            "title": "State"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "post_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Post Id"
          }
        },
        "type": "object",
        "required": [
          "state",
          "expected_version",
          "post_id"
        ],
        "title": "BatchItem"
      },
      "BatchLabels": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BatchItem"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "items"
        ],
        "title": "BatchLabels"
      },
      "Candidate": {
        "properties": {
          "post_id": {
            "type": "integer",
            "title": "Post Id"
          },
          "rating": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "md5": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Md5"
          },
          "tags": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Tags"
          },
          "score": {
            "type": "integer",
            "title": "Score"
          },
          "posted_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Posted At"
          },
          "media_ext": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Media Ext"
          },
          "width": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Width"
          },
          "height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Height"
          },
          "unavailable": {
            "type": "boolean",
            "title": "Unavailable"
          },
          "has_preview": {
            "type": "boolean",
            "title": "Has Preview"
          },
          "has_original": {
            "type": "boolean",
            "title": "Has Original"
          },
          "has_video_fallback": {
            "type": "boolean",
            "title": "Has Video Fallback"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "unsure"
                ]
